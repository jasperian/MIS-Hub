{
  "name": "mis-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed-users": "tsx scripts/seed-dealership-users.ts",
    "db:export-user-sql": "tsx scripts/export-user-seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:dealerships": "tsx scripts/dealership-migrate.ts",
    "mcp": "tsx scripts/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
