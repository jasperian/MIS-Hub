generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  IT
  MANAGER
  MEMBER
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String @db.Text
  role Role @default(MEMBER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  dealerships UserDealership[]
  sessions Session[]
  credentials Credential[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  expiresAt DateTime
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model InventoryRecord {
  dealershipId String @default("dealer-1")
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  @@index([dealershipId])
  id String @id @default(cuid())
  kind String
  name String
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sapUser SapUser?
  @@index([kind])
}
model Credential {
  dealershipId String @default("dealer-1")
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  @@index([dealershipId])
  id String @id @default(cuid())
  title String
  username String
  url String?
  encryptedSecret String @db.Text
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId])
}
model AuditLog {
  dealershipId String?
  dealership Dealership? @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  @@index([dealershipId, createdAt])
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  details Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Ms365Batch {
  dealershipId String @default("dealer-1")
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  @@index([dealershipId])
  id String @id @default(cuid())
  batchNumber Int
  accountEmail String
  encryptedSecret String @db.Text
  status Ms365BatchStatus @default(ACTIVE)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments Ms365Assignment[]

  @@unique([dealershipId, batchNumber])
  @@unique([dealershipId, accountEmail])
  @@index([status])
}

model Ms365Assignment {
  id String @id @default(cuid())
  batchId String
  slotNumber Int
  memberId String
  computerId String?
  externalDeviceName String?
  installedAt DateTime @default(now())
  releasedAt DateTime?
  status Ms365AssignmentStatus @default(ACTIVE)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batch Ms365Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@index([memberId, status])
  @@index([computerId, status])
}

enum Ms365BatchStatus {
  ACTIVE
  INACTIVE
}

enum Ms365AssignmentStatus {
  ACTIVE
  RELEASED
}

model Dealership {
  id String @id @default(cuid())
  name String
  users UserDealership[]
  records InventoryRecord[]
  credentials Credential[]
  batches Ms365Batch[]
  events AuditLog[]
  sapUsers SapUser[]
}
model SapUser {
  id String @id @default(cuid())
  firstName String
  lastName String
  sapId String @unique
  department String
  status SapUserStatus @default(ACTIVE)
  dealershipId String
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  memberId String? @unique
  member InventoryRecord? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  validFrom DateTime? @db.Date
  validTo DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([dealershipId])
  @@index([lastName, firstName])
}
enum SapUserStatus {
  ACTIVE
  INACTIVE
}
model UserDealership {
  userId String
  dealershipId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Restrict)
  @@id([userId, dealershipId])
  @@index([dealershipId])
}
