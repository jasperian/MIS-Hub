# Copy to .env. Replace placeholders; do not commit real credentials.
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
# Match MYSQL_PASSWORD; URL-encode password characters when used in this URL.
DATABASE_URL="mysql://mis_app:replace-with-a-long-random-database-password@127.0.0.1:3306/mis_hub"
APP_URL="http://127.0.0.1:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=replace-with-64-random-hexadecimal-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
BOOTSTRAP_ADMIN_NAME="MIS Administrator"
# Password recovery email. Use your SMTP server and a verified sender address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="MIS Hub <mis@example.com>"
